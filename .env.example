# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_REGISTRATION_KEY=JLMZGY_TSL

# Auth cookie signing is not implemented yet, but keep this value private if you add JWT later.
JWT_SECRET=change-this-random-string

# Optional AI settings. Keep AI disabled unless you have a compatible API key.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_TEMPERATURE=0.2

# Local model examples:
# Ollama: AI_BASE_URL=http://localhost:11434/v1, AI_MODEL=qwen2.5:7b, AI_API_KEY=
# LM Studio: AI_BASE_URL=http://localhost:1234/v1, AI_MODEL=local-model, AI_API_KEY=

# Optional. Put A/B/C source folders here when importing source files.
# Leave empty to use imports/sources inside this project.
# SOURCE_IMPORT_DIR=F:\your-source-library
